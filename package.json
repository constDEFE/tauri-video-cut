		"license-checker-rseidelsohn": "^5.0.1",
		"oxfmt": "^0.57.0",
		"oxlint": "^1.72.0",
		"tailwindcss": "^4.3.0",
		"typescript": "6.0.3",
		"vite": "^8.0.16"
	}
}
