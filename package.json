		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-shell": "^2.3.5",
		"clsx": "^2.1.1",
		"nanoid": "^5.1.11",
		"preact": "^10.29.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tauri-plugin-libmpv-api": "^0.3.2",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
