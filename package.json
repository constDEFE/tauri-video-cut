	},
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"lint": "oxlint ./src",
		"lint:fix": "oxlint ./src --fix",
		"format": "oxfmt --write \"src/**/*.{ts,tsx,css,json}\"",
		"format:check": "oxfmt --check \"src/**/*.{ts,tsx,css,json}\"",
		"check": "tsc --noEmit && oxlint ./src && oxfmt --check \"src/**/*.{ts,tsx,css,json}\"",
		"legal": "bun scripts/generate-legal.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.5.0",
		"@tanstack/react-hotkeys": "^0.10.0",
